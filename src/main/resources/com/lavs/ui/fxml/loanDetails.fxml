<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lavs.ui.LoanDetailsController" spacing="18" minWidth="0">
 <Button text="Back to loans" onAction="#back" accessibleText="Back to loans"/>
 <Label text="Loan details" styleClass="heading" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
 <Label fx:id="loanHeading" wrapText="true" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
 <GridPane hgap="18" vgap="14" style="-fx-font-size: 18px;">
  <Label text="Loan ID" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
  <Label fx:id="loanIdValue" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
  <Label text="Customer ID" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
  <Label fx:id="customerIdValue" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
  <Label text="Status" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
  <Label fx:id="statusValue" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
  <Label text="Amount" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
  <Label fx:id="amountValue" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
 </GridPane>
</VBox>
