<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="12" minWidth="0"
 style="-fx-padding: 12; -fx-background-color: #f7f7fb; -fx-border-color: #dddce8; -fx-background-radius: 10; -fx-border-radius: 10;">
  <HBox spacing="10" alignment="CENTER_LEFT">
    <Label fx:id="summary" wrapText="true" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    <Button text="Edit" fx:id="edit" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/><Button text="Remove" fx:id="remove" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/>
  </HBox>
  <VBox fx:id="editorContainer" spacing="12" minWidth="0"/>
</VBox>