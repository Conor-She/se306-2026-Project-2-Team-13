<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lavs.ui.CustomersController" minWidth="0" minHeight="0">
 <VBox fx:id="listView" spacing="18" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS">
  <HBox spacing="24" alignment="CENTER_LEFT" minWidth="0">
   <Label text="Search Customers" minWidth="0" wrapText="true" styleClass="heading" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
   <Region HBox.hgrow="ALWAYS"/>
   <Button text="+ Add New Customer" minWidth="0" wrapText="true" onAction="#openAddCustomer" style="-fx-background-color: #F8F40C; -fx-text-fill: black; -fx-font-size: 16; -fx-padding: 10 18; -fx-background-radius: 7; -fx-border-color: #393A7B; -fx-border-radius: 7;"/>
  </HBox>
  <TextField fx:id="searchField" promptText="Search customers"
             accessibleText="Search customers"
             minHeight="56" prefHeight="56" maxHeight="56"
             style="-fx-font-size: 20; -fx-padding: 12 16;"/>
  <Label fx:id="resultsHeading" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
  <TableView fx:id="customerTable" minWidth="0" minHeight="0" fixedCellSize="50" style="-fx-font-size: 18px;" VBox.vgrow="ALWAYS">
   <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
   <columns>
    <TableColumn fx:id="idColumn" text="Customer ID" prefWidth="110" minWidth="95"/>
    <TableColumn fx:id="nameColumn" text="Name" prefWidth="210" minWidth="120"/>
    <TableColumn fx:id="dateOfBirthColumn" text="Date of Birth" prefWidth="160" minWidth="140"/>
   </columns>
  </TableView>
 </VBox>
 <fx:include fx:id="detailsView" source="customerDetails.fxml" visible="false" managed="false" VBox.vgrow="ALWAYS"/>
</VBox>
