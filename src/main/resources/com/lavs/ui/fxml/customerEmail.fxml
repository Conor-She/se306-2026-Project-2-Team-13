<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.layout.*?>
<FlowPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" hgap="16" vgap="12" minWidth="0"><VBox spacing="6" minWidth="0" prefWidth="260">
      <TextFlow style="-fx-font-weight: bold;"><Text text="Email address "/><Text text="*" fill="#b42318"/><Text text=""/></TextFlow>
      <TextField fx:id="email" accessibleText="Email address *" promptText="Email address" maxWidth="Infinity" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
      <Label fx:id="emailError" wrapText="true" visible="false" managed="false" styleClass="field-error" style="-fx-text-fill: #b42318; -fx-font-size: 13px;"/>
    </VBox><CheckBox fx:id="primary" text="Primary email"/></FlowPane>
