<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<FlowPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" hgap="16" vgap="12" minWidth="0"><VBox spacing="6" minWidth="0" prefWidth="260">
      <TextFlow style="-fx-font-weight: bold;"><Text text="Employer name "/><Text text="*" fill="#b42318"/><Text text=""/></TextFlow>
      <TextField fx:id="name" accessibleText="Employer name *" promptText="Employer name" maxWidth="Infinity" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
      <Label fx:id="nameError" wrapText="true" visible="false" managed="false" styleClass="field-error" style="-fx-text-fill: #b42318; -fx-font-size: 13px;"/>
    </VBox><VBox spacing="6" minWidth="0" prefWidth="260">
      <Label text="Job title" style="-fx-font-weight: bold;"/>
      <TextField fx:id="role" accessibleText="Job title" promptText="Job title" maxWidth="Infinity" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
      <Label fx:id="roleError" wrapText="true" visible="false" managed="false" styleClass="field-error" style="-fx-text-fill: #b42318; -fx-font-size: 13px;"/>
    </VBox>
    <VBox spacing="6" minWidth="0" prefWidth="260">
      <Label text="Employment type" style="-fx-font-weight: bold;"/>
      <ComboBox fx:id="employmentType" prefHeight="${name.height}" minHeight="${name.height}" maxHeight="${name.height}" accessibleText="Employment type" promptText="Select employment type" maxWidth="Infinity" style="-fx-padding: 0 6; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;">
        <items><FXCollections fx:factory="observableArrayList">
          <String fx:value="Full-time"/><String fx:value="Part-time"/><String fx:value="Casual"/>
          <String fx:value="Contract"/><String fx:value="Self-employed"/><String fx:value="Other"/>
        </FXCollections></items>
      </ComboBox>
    </VBox>
    <VBox spacing="6" minWidth="0" prefWidth="260">
      <Label text="Annual income (NZD)" style="-fx-font-weight: bold;"/>
      <TextField fx:id="income" accessibleText="Annual income (NZD)" promptText="e.g. 50000.00" maxWidth="Infinity" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
      <Label fx:id="incomeError" wrapText="true" visible="false" managed="false" styleClass="field-error" style="-fx-text-fill: #b42318; -fx-font-size: 13px;"/>
    </VBox>
  </FlowPane>
