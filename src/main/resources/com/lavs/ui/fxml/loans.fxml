<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lavs.ui.LoansController" minWidth="0" minHeight="0">
 <fx:define>
  <String fx:id="loanStyles" fx:value=".loan-search-page { -fx-background-color: #ffffff; }
.loan-search-header, .loan-results-card {     -fx-background-color: linear-gradient(to right, #fafbff, #ffffff);     -fx-border-color: #dfe3ff; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 20; }
.loan-header-avatar { -fx-background-color: #e8e7ff; -fx-background-radius: 40; }
.loan-search-title { -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #393a7b; }
.loan-search-subtitle { -fx-font-size: 13px; -fx-text-fill: #6569a4; }
.loan-add-button {     -fx-background-color: #F8F40C; -fx-text-fill: #393a7b;     -fx-font-size: 13px; -fx-font-weight: bold;     -fx-padding: 10 16; -fx-background-radius: 8; -fx-background-insets: 0;     -fx-border-color: #e1dd45; -fx-border-width: 1;     -fx-border-radius: 8; -fx-cursor: hand; }
.loan-add-button:hover { -fx-background-color: #eeeb0b; -fx-border-color: #cfcb34; }
.loan-add-button:pressed { -fx-background-color: #e1de0b; }
.loan-add-button:focused { -fx-border-color: #7773cc; -fx-border-width: 2; -fx-padding: 9 15; }
.loan-search-bar {     -fx-background-color: #ffffff; -fx-border-color: #dfe3ff;     -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4 18; }
.loan-search-input, .loan-search-input:focused {     -fx-background-color: transparent; -fx-border-width: 0; -fx-background-insets: 0;     -fx-padding: 10 0; -fx-font-size: 15px; -fx-text-fill: #393a7b; -fx-prompt-text-fill: #9295bf; }
.loan-results-heading { -fx-text-fill: #6569a4; -fx-font-size: 14px; }
.loan-results-footer { -fx-text-fill: #747ba6; -fx-font-size: 12px; -fx-padding: 5 0 0 0; }
.loan-results-table {     -fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 0;     -fx-table-cell-border-color: transparent; -fx-font-size: 14px; }
.loan-results-table .column-header-background { -fx-background-color: #eef0ff; -fx-background-radius: 5 5 0 0; }
.loan-results-table .column-header, .loan-results-table .filler { -fx-background-color: transparent; -fx-border-width: 0; -fx-size: 42; }
.loan-results-table .column-header .label {     -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;     -fx-text-fill: #6569a4; -fx-font-size: 11px; -fx-font-weight: bold; }
.loan-results-table .table-row-cell { -fx-background-color: transparent; -fx-border-color: transparent transparent #e9ecff transparent; -fx-border-width: 0 0 1 0; }
.loan-results-table .table-row-cell:empty { -fx-border-width: 0; }
.loan-results-table .table-row-cell:filled:hover { -fx-background-color: #f0f1ff; -fx-cursor: hand; }
.loan-results-table .table-row-cell:filled:selected { -fx-background-color: #e6e5ff; }
.loan-results-table .table-cell { -fx-alignment: CENTER_LEFT; -fx-padding: 0 14; -fx-text-fill: #393a7b; -fx-border-width: 0; }
.loan-results-table .placeholder .label { -fx-text-fill: #747ba6; -fx-font-size: 14px; }
.loan-profile-link { -fx-text-fill: #5553ac; -fx-font-size: 13px; -fx-padding: 6 0; -fx-border-width: 0; -fx-underline: false; }
.loan-profile-link:hover { -fx-underline: true; }
"/>
 </fx:define>
 <VBox fx:id="listView" spacing="16" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS" styleClass="loan-search-page">
  <HBox spacing="18" alignment="CENTER_LEFT" minWidth="0" styleClass="loan-search-header">
   <StackPane minWidth="60" prefWidth="60" maxWidth="60" minHeight="60" maxHeight="60" styleClass="loan-header-avatar">
    <Label text="\%" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #4947a5;"/>
   </StackPane>
   <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
    <Label text="Search Loans" wrapText="true" styleClass="loan-search-title"/>
    <Label text="Find and manage customer loans." wrapText="true" styleClass="loan-search-subtitle"/>
   </VBox>
   <Button text="+  Add Loan" onAction="#openAddLoan" styleClass="loan-add-button"/>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="loan-search-bar">
   <SVGPath content="M 14 6 A 6 6 0 1 1 2 6 A 6 6 0 1 1 14 6 M 12 11 L 18 17" fill="TRANSPARENT" stroke="#5553a6" strokeWidth="1.8" mouseTransparent="true"/>
   <TextField fx:id="searchField" promptText="Search by loan ID, customer name or customer ID"
              accessibleText="Search by loan ID, customer name or customer ID"
              onAction="#searchLoans" HBox.hgrow="ALWAYS" minWidth="0" styleClass="loan-search-input"/>
  </HBox>
  <VBox spacing="12" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS" styleClass="loan-results-card">
   <Label fx:id="resultsHeading" wrapText="true" styleClass="loan-results-heading"/>
   <TableView fx:id="loanTable" minWidth="0" minHeight="160" fixedCellSize="58" styleClass="loan-results-table" VBox.vgrow="ALWAYS">
    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
    <columns>
     <TableColumn fx:id="idColumn" text="LOAN ID" prefWidth="245" minWidth="210"/>
     <TableColumn fx:id="customerIdColumn" text="CUSTOMER ID" prefWidth="190" minWidth="160"/>
     <TableColumn fx:id="statusColumn" text="STATUS" prefWidth="110" minWidth="90"/>
     <TableColumn fx:id="amountColumn" text="AMOUNT" prefWidth="130" minWidth="110"/>
     <TableColumn fx:id="typeColumn" text="TYPE" prefWidth="170" minWidth="130"/>
     <TableColumn fx:id="actionsColumn" text="ACTIONS" prefWidth="130" minWidth="120" sortable="false"/>
    </columns>
   </TableView>
   <Label fx:id="resultsFooter" styleClass="loan-results-footer"/>
  </VBox>
 </VBox>
 <fx:include fx:id="detailsView" source="loanDetails.fxml" visible="false" managed="false" VBox.vgrow="ALWAYS"/>
</VBox>