<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lavs.ui.AddLoanController" spacing="22" minWidth="0" style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 20; -fx-border-color: #d6d5e3; -fx-border-radius: 20; -fx-font-family: 'Arial'; -fx-font-size: 16px;">
<fx:define>
    <String fx:id="scrollBarStyle" fx:value="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-pref-width: 10;"/>
    <String fx:id="scrollTrackStyle" fx:value="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background-insets: 0;"/>
    <String fx:id="scrollThumbStyle" fx:value="-fx-background-color: #9693ca; -fx-background-radius: 8; -fx-background-insets: 2;"/>
    <String fx:id="scrollButtonStyle" fx:value="-fx-background-color: transparent; -fx-padding: 0; -fx-min-width: 0; -fx-pref-width: 0; -fx-max-width: 0; -fx-min-height: 0; -fx-pref-height: 0; -fx-max-height: 0; -fx-opacity: 0;"/>
    <String fx:id="coborrowerRowStyle" fx:value="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
    <String fx:id="removeButtonStyle" fx:value="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #D95733; -fx-text-fill: #D95733;"/>
</fx:define>
<Label text="Add New Loan" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #242438;"/>
<FlowPane hgap="14" vgap="10" rowValignment="CENTER"><HBox spacing="8" alignment="CENTER_LEFT"><Label fx:id="marker0" text="1" style="-fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #D95733; -fx-background-color: #D95733; -fx-text-fill: white;"/><Label fx:id="stepName0" text="Loan Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/></HBox><Region minWidth="36" prefWidth="36" maxWidth="36" minHeight="2" prefHeight="2" maxHeight="2" style="-fx-background-color: #D95733;"/><HBox spacing="8" alignment="CENTER_LEFT"><Label fx:id="marker1" text="2" style="-fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #D95733; -fx-text-fill: #D95733;"/><Label fx:id="stepName1" text="Co-borrowers (optional)" style="-fx-text-fill: #242438;"/></HBox><Region minWidth="36" prefWidth="36" maxWidth="36" minHeight="2" prefHeight="2" maxHeight="2" style="-fx-background-color: #D95733;"/><HBox spacing="8" alignment="CENTER_LEFT"><Label fx:id="marker2" text="3" style="-fx-min-width: 30; -fx-min-height: 30; -fx-alignment: center; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #D95733; -fx-text-fill: #D95733;"/><Label fx:id="stepName2" text="Review" style="-fx-text-fill: #242438;"/></HBox></FlowPane>
<Label fx:id="message" wrapText="true" visible="false" managed="false" style="-fx-background-color: #efedf9; -fx-text-fill: #393a7b; -fx-padding: 12; -fx-background-radius: 8;"/>
<Label fx:id="reviewNotice" text="Editing from Review. Your other details are kept." wrapText="true" visible="false" managed="false" style="-fx-background-color: #efedf9; -fx-text-fill: #393a7b; -fx-padding: 12; -fx-background-radius: 8;"/>
<ScrollPane fx:id="loanScroll" fitToWidth="true" hbarPolicy="NEVER" minHeight="180" VBox.vgrow="ALWAYS" style="-fx-background: white; -fx-background-color: white; -fx-border-width: 0; -fx-padding: 0;">
<content><VBox spacing="18" minWidth="0"><VBox fx:id="detailsPane" spacing="18" minWidth="0">
<VBox spacing="14" minWidth="0" style="-fx-padding: 20; -fx-border-color: #dce2ff; -fx-border-radius: 14; -fx-background-radius: 14; -fx-background-color: #efedf9;">
<Label text="Primary borrower" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/>
<TextFlow><Text text="Search for an existing customer. Fields marked "/><Text text="*" fill="#b42318"/><Text text=" are required."/></TextFlow>
<TextField minHeight="44" prefHeight="44" maxHeight="44" fx:id="customerSearch" promptText="Search by name or customer ID" accessibleText="Search for primary borrower" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
<ListView fx:id="customerResults" prefHeight="150" visible="false" managed="false"/>
<HBox fx:id="selectedBorrower" spacing="12" alignment="CENTER_LEFT" visible="false" managed="false" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"><Label fx:id="borrowerName" wrapText="true" minWidth="0"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="editCustomer" text="Edit customer" accessibleText="Edit primary borrower customer" onAction="#editPrimaryCustomer" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/><Button text="Remove" onAction="#clearBorrower" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #D95733; -fx-text-fill: #D95733;"/></HBox>
<Label fx:id="prerequisiteNotice" wrapText="true" visible="false" managed="false" style="-fx-background-color: #fff1ef; -fx-text-fill: #9b241c; -fx-padding: 12; -fx-background-radius: 8;"/>
</VBox>
<VBox spacing="14" minWidth="0" style="-fx-padding: 20; -fx-border-color: #d6d5e3; -fx-border-radius: 14; -fx-background-radius: 14; -fx-background-color: white;"><Label text="Loan details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/><FlowPane hgap="20" vgap="16"><VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Loan type "/><Text text="*" fill="#b42318"/></TextFlow><ComboBox fx:id="loanType" accessibleText="Loan type" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 0; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;" promptText="Select loan type"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Principal ($) "/><Text text="*" fill="#b42318"/></TextFlow><TextField fx:id="principal" accessibleText="Principal ($)" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;" promptText="500000.00"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Interest rate (%) "/><Text text="*" fill="#b42318"/></TextFlow><TextField fx:id="interestRate" accessibleText="Interest rate (%)" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;" promptText="6.25"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Payment frequency "/><Text text="*" fill="#b42318"/></TextFlow><ComboBox fx:id="paymentFrequency" accessibleText="Payment frequency" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 0; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;" promptText="Select payment frequency"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Rate frequency "/><Text text="*" fill="#b42318"/></TextFlow><ComboBox fx:id="rateFrequency" accessibleText="Rate frequency" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 0; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;" promptText="Select rate frequency"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Term (months) "/><Text text="*" fill="#b42318"/></TextFlow><TextField fx:id="term" accessibleText="Term (months)" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;" promptText="360"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Start date "/><Text text="*" fill="#b42318"/></TextFlow><DatePicker fx:id="startDate" accessibleText="Start date" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 0; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Renewal date "/><Text text="*" fill="#b42318"/></TextFlow><DatePicker fx:id="renewDate" accessibleText="Renewal date" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 0; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/></VBox>
<VBox spacing="6" prefWidth="280" minWidth="280" maxWidth="280"><TextFlow style="-fx-font-weight: bold;"><Text text="Status "/><Text text="*" fill="#b42318"/></TextFlow><ComboBox fx:id="status" accessibleText="Status" minWidth="280" prefWidth="280" maxWidth="280" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 0; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;" promptText="Select status"/></VBox>
</FlowPane></VBox>
</VBox>
<VBox fx:id="coborrowersPane" visible="false" managed="false" spacing="18" minWidth="0" style="-fx-padding: 20; -fx-border-color: #dce2ff; -fx-border-radius: 14; -fx-background-radius: 14; -fx-background-color: #efedf9;">
<Label text="Search for existing customer" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/>
<Label text="Search by name or customer ID. You can add up to three co-borrowers, or continue without any." wrapText="true"/>
<TextField fx:id="coborrowerSearch" promptText="Search by name or customer ID" accessibleText="Search for co-borrowers" minHeight="44" prefHeight="44" maxHeight="44" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #b9b7cd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
<ListView fx:id="coborrowerResults" prefHeight="150" visible="false" managed="false"><placeholder><Label text="No eligible customers found"/></placeholder></ListView>
<Label fx:id="coborrowerCount" text="Added co-borrowers (0/3)" style="-fx-font-weight: bold;"/>
<Label fx:id="emptyCoborrowers" text="No co-borrowers added. This step is optional." wrapText="true"/>
<VBox fx:id="coborrowerRows" spacing="12" minWidth="0"/>
</VBox><VBox fx:id="reviewPane" spacing="18" minWidth="0" visible="false" managed="false">
<Label text="Please review the details below. Select Edit to make changes." wrapText="true"/>
<VBox spacing="14" minWidth="0" style="-fx-padding: 20; -fx-border-color: #dce2ff; -fx-border-radius: 14; -fx-background-radius: 14; -fx-background-color: #efedf9;"><HBox spacing="12" alignment="CENTER_LEFT"><Label text="Primary borrower" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="editBorrower" text="Edit" onAction="#editBorrower" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/></HBox><Label fx:id="reviewBorrower" wrapText="true" minWidth="0"/></VBox>
<VBox spacing="16" minWidth="0" style="-fx-padding: 20; -fx-border-color: #d6d5e3; -fx-border-radius: 14; -fx-background-radius: 14; -fx-background-color: white;"><HBox spacing="12" alignment="CENTER_LEFT"><Label text="Loan details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="editLoanDetails" text="Edit" onAction="#editLoanDetails" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/></HBox><FlowPane hgap="20" vgap="16"><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Loan type" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewType" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Principal" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewPrincipal" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Interest rate" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewInterest" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Payment frequency" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewPaymentFrequency" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Rate frequency" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewRateFrequency" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Term" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewTerm" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Start date" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewStartDate" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Renewal date" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewRenewDate" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox><VBox spacing="6" prefWidth="280" minWidth="0"><Label text="Status" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><Label fx:id="reviewStatus" wrapText="true" minWidth="0" maxWidth="Infinity"/></VBox></FlowPane></VBox>
<VBox spacing="14" minWidth="0" style="-fx-padding: 20; -fx-border-color: #d6d5e3; -fx-border-radius: 14; -fx-background-radius: 14; -fx-background-color: white;"><HBox spacing="12" alignment="CENTER_LEFT"><Label fx:id="reviewCoborrowerCount" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="editCoborrowers" text="Edit" onAction="#editCoborrowers" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/></HBox><VBox fx:id="reviewCoborrowers" spacing="12" minWidth="0"/></VBox>
<VBox spacing="16" minWidth="0" style="-fx-padding: 20; -fx-border-color: #d6d5e3; -fx-border-radius: 14; -fx-background-radius: 14; -fx-background-color: white;">
<Label text="Repayment schedule" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #242438;"/>
<Label text="Preview based on the current loan details and interest rate." wrapText="true"/>
<FlowPane hgap="30" vgap="12"><Label fx:id="repaymentCount" style="-fx-font-weight: bold; -fx-text-fill: #393a7b;"/><VBox spacing="6"><Label text="Total repayments" style="-fx-font-weight: bold;"/><Label fx:id="totalRepayable"/></VBox><VBox spacing="6"><Label text="Total interest" style="-fx-font-weight: bold;"/><Label fx:id="totalInterest"/></VBox></FlowPane>
<TableView fx:id="repaymentTable" minWidth="0" minHeight="240" prefHeight="320" maxHeight="320" fixedCellSize="44" accessibleText="Generated repayment schedule">
<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
<columns><TableColumn fx:id="dueDateColumn" text="Due date" prefWidth="160" minWidth="130"/><TableColumn fx:id="paymentColumn" text="Payment" prefWidth="170" minWidth="140"/><TableColumn fx:id="principalColumn" text="Principal" prefWidth="170" minWidth="140"/><TableColumn fx:id="interestColumn" text="Interest" prefWidth="150" minWidth="120"/><TableColumn fx:id="balanceColumn" text="Balance" prefWidth="180" minWidth="150"/></columns>
</TableView>
</VBox>
</VBox></VBox></content></ScrollPane>
<HBox spacing="12" alignment="CENTER_LEFT"><Button fx:id="cancel" text="Cancel" onAction="#cancel" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="back" text="Back" onAction="#back" visible="false" managed="false" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: white; -fx-border-color: #9693ca; -fx-text-fill: #393a7b;"/><Button fx:id="next" text="Next" onAction="#next" style="-fx-cursor: hand; -fx-padding: 9 16; -fx-background-radius: 7; -fx-border-radius: 7; -fx-font-size: 15px; -fx-background-color: #f8f40c; -fx-text-fill: black; -fx-border-color: #b6b309; -fx-font-weight: bold;"/></HBox>
</VBox>
