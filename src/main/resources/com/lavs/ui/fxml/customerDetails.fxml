    <columnConstraints>
     <ColumnConstraints percentWidth="15"/><ColumnConstraints percentWidth="20"/>
     <ColumnConstraints percentWidth="20"/><ColumnConstraints percentWidth="20"/>
     <ColumnConstraints percentWidth="17"/><ColumnConstraints percentWidth="8" halignment="CENTER"/>
    </columnConstraints>
    <rowConstraints><RowConstraints minHeight="34"/></rowConstraints>
    <Region GridPane.columnSpan="6" maxWidth="Infinity" maxHeight="Infinity" style="-fx-background-color: #f2f6ff; -fx-background-radius: 8 8 0 0;"/>
