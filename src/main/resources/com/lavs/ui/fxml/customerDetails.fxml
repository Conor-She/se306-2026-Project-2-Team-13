<?import javafx.scene.shape.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lavs.ui.CustomerDetailsController" spacing="18" minWidth="0"
      style="-fx-background-color: white; -fx-font-family: &quot;Segoe UI&quot;;">
 <fx:define>
  <String fx:id="scrollBarStyle" fx:value="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-pref-width: 10;"/>
