     <Label text="View and manage notes related to this customer." wrapText="true" style="$mutedStyle"/>
    </VBox>
    <Button text="+  Add Note" onAction="#addNote" style="-fx-background-color: #5b56b5; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 16; -fx-cursor: hand;"/>
   </HBox>
  </VBox></content>
 </ScrollPane>
 <ScrollPane fx:id="documentsContent" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white; -fx-padding: 0;">
  <content><VBox spacing="12" minWidth="0" style="-fx-padding: 0 12 12 12;">
   <fx:define>
    <String fx:id="documentHeaderStyle" fx:value="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #747ba6;"/>
    <String fx:id="documentCellStyle" fx:value="-fx-font-size: 12px; -fx-text-fill: #55558d;"/>
    <String fx:id="documentActionStyle" fx:value="-fx-background-color: transparent; -fx-text-fill: #747ba6; -fx-font-size: 19px; -fx-padding: 4 10; -fx-min-width: 36; -fx-min-height: 36; -fx-cursor: hand;"/>
   </fx:define>
   <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #f2f6ff; -fx-background-radius: 9; -fx-padding: 14 16;">
