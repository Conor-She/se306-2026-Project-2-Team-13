  <ToggleGroup fx:id="customerTabs"/>
  <String fx:id="tabStyle" fx:value="-fx-background-color: transparent; -fx-text-fill: #55558d; -fx-font-size: 14px; -fx-padding: 4 17 11 17; -fx-border-width: 0 0 5 0; -fx-border-color: transparent; -fx-border-radius: 0; -fx-cursor: hand;"/>
  <String fx:id="selectedTabStyle" fx:value="-fx-font-weight: bold; -fx-text-fill: #20205e;"/>
  <String fx:id="focusStyle" fx:value="-fx-background-color: #f3f3fa;"/>
  <String fx:id="cardStyle" fx:value="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 9; -fx-background-radius: 9;"/>
  <String fx:id="cardHeaderStyle" fx:value="-fx-background-color: #f5f6ff; -fx-background-radius: 9 9 0 0; -fx-padding: 12 20;"/>
  <String fx:id="titleStyle" fx:value="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #20205e;"/>
  <String fx:id="mutedStyle" fx:value="-fx-font-size: 12px; -fx-text-fill: #626499;"/>
  <String fx:id="valueStyle" fx:value="-fx-font-size: 13px; -fx-text-fill: #20205e;"/>
  <String fx:id="actionStyle" fx:value="-fx-background-color: transparent; -fx-text-fill: #55558d; -fx-font-size: 22px; -fx-padding: 0 6; -fx-cursor: hand;"/>
 </fx:define>
 <Button text="&#x27F5;  Back to Search" onAction="#back" fx:id="backButton" style="-fx-background-color: transparent; -fx-text-fill: #55558d; -fx-font-size: 14px; -fx-padding: 4 0; -fx-cursor: hand;"/>
 <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-width: 1; -fx-border-radius: 13; -fx-background-radius: 13; -fx-padding: 14 20; -fx-min-height: 78;">
  <Pane minWidth="56" prefWidth="56" maxWidth="56" minHeight="56" prefHeight="56" maxHeight="56">
   <Circle centerX="28" centerY="28" radius="28" fill="#efedff"/>
   <Circle centerX="28" centerY="21" radius="9.5" fill="#393a7b"/>
   <SVGPath content="M 11 47 C 13 31 43 31 45 47 Q 28 59 11 47 Z" fill="#393a7b"/>
  </Pane>
  <VBox alignment="CENTER_LEFT" spacing="5" minWidth="0" HBox.hgrow="ALWAYS">
   <Label fx:id="customerHeading" wrapText="true" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #20205e;"/>
   <Label fx:id="customerId" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #626499;"/>
  </VBox>
  <Region HBox.hgrow="ALWAYS"/>
  <Button accessibleText="Edit customer information" onAction="#editPersonal" minWidth="40" minHeight="44" style="-fx-background-color: transparent; -fx-padding: 8 14; -fx-cursor: hand;">
   <graphic><VBox alignment="CENTER" spacing="4" mouseTransparent="true">
    <Circle radius="2.5" fill="#393A7B"/>
    <Circle radius="2.5" fill="#393A7B"/>
    <Circle radius="2.5" fill="#393A7B"/>
   </VBox></graphic>
  </Button>
 </HBox>
 <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-border-color: transparent transparent #dce2ff transparent; -fx-border-width: 0 0 1 0;">
  <StackPane>
   <ToggleButton fx:id="detailsTab" text="Details" selected="true" toggleGroup="$customerTabs" style="$tabStyle"/>
   <Region visible="${detailsTab.selected}" mouseTransparent="true" minHeight="5" prefHeight="5" maxHeight="5" StackPane.alignment="BOTTOM_CENTER" style="-fx-background-color: #ff642e; -fx-background-radius: 7 7 0 0;"/>
  </StackPane>
  <StackPane>
   <ToggleButton fx:id="loansTab" text="Loans" toggleGroup="$customerTabs" style="$tabStyle"/>
   <Region visible="${loansTab.selected}" mouseTransparent="true" minHeight="5" prefHeight="5" maxHeight="5" StackPane.alignment="BOTTOM_CENTER" style="-fx-background-color: #ff642e; -fx-background-radius: 7 7 0 0;"/>
  </StackPane>
  <StackPane>
   <ToggleButton fx:id="notesTab" text="Notes" toggleGroup="$customerTabs" style="$tabStyle"/>
   <Region visible="${notesTab.selected}" mouseTransparent="true" minHeight="5" prefHeight="5" maxHeight="5" StackPane.alignment="BOTTOM_CENTER" style="-fx-background-color: #ff642e; -fx-background-radius: 7 7 0 0;"/>
  </StackPane>
  <StackPane>
   <ToggleButton fx:id="documentsTab" text="Documents" toggleGroup="$customerTabs" style="$tabStyle"/>
   <Region visible="${documentsTab.selected}" mouseTransparent="true" minHeight="5" prefHeight="5" maxHeight="5" StackPane.alignment="BOTTOM_CENTER" style="-fx-background-color: #ff642e; -fx-background-radius: 7 7 0 0;"/>
  </StackPane>
  <StackPane>
   <ToggleButton fx:id="guarantorsTab" text="Guarantors" toggleGroup="$customerTabs" style="$tabStyle"/>
   <Region visible="${guarantorsTab.selected}" mouseTransparent="true" minHeight="5" prefHeight="5" maxHeight="5" StackPane.alignment="BOTTOM_CENTER" style="-fx-background-color: #ff642e; -fx-background-radius: 7 7 0 0;"/>
  </StackPane>
 </HBox>
 <StackPane minWidth="0" VBox.vgrow="ALWAYS">
 <ScrollPane fx:id="detailsContent" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white; -fx-padding: 0;">
 <content><VBox spacing="16" minWidth="0" style="-fx-padding: 0 12 12 12;">
 <VBox spacing="4" style="-fx-background-color: #f2f6ff; -fx-background-radius: 9; -fx-padding: 14 16;">
  <Label text="Customer Overview" style="$titleStyle"/>
  <Label text="Key information about the customer at a glance." wrapText="true" style="$mutedStyle"/>
 </VBox>
 <GridPane fx:id="overviewCards" hgap="14" vgap="14" minWidth="0">
 <VBox fx:id="personalCard" minWidth="0" GridPane.fillHeight="false" GridPane.valignment="TOP" style="$cardStyle">
<HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f5f6ff; -fx-background-radius: 9 9 0 0; -fx-padding: 12;"><StackPane minWidth="24" prefWidth="24"><SVGPath content="M 10 0 A 5 5 0 1 1 10 10 A 5 5 0 1 1 10 0 Z M 0 22 C 0 8 20 8 20 22 Q 10 25 0 22 Z" fill="#393a7b"/></StackPane><Label text="Personal Information" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #20205e;"/><Region HBox.hgrow="ALWAYS"/><Button accessibleText="Edit personal information" onAction="#editPersonal" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #55558d; -fx-padding: 4 7; -fx-cursor: hand;"><graphic><SVGPath content="M 1 15 L 4 8 L 12 0 L 16 4 L 8 12 Z M 4 8 L 8 12 M 10 2 L 14 6" fill="transparent" stroke="#55558d" strokeWidth="1.3"/></graphic></Button></HBox>
 <GridPane hgap="10" vgap="12" style="-fx-padding: 18 16;"><columnConstraints><ColumnConstraints percentWidth="40"/><ColumnConstraints percentWidth="60"/></columnConstraints>
<Label text="Title" GridPane.rowIndex="0" style="$mutedStyle"/><Label fx:id="titleValue" GridPane.rowIndex="0" GridPane.columnIndex="1" wrapText="true" minWidth="0" style="$valueStyle"/>
<Label text="First name" GridPane.rowIndex="1" style="$mutedStyle"/><Label fx:id="firstNameValue" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true" minWidth="0" style="$valueStyle"/>
<Label text="Last name" GridPane.rowIndex="2" style="$mutedStyle"/><Label fx:id="lastNameValue" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true" minWidth="0" style="$valueStyle"/>
<Label text="Date of birth" GridPane.rowIndex="3" style="$mutedStyle"/><Label fx:id="birthDateValue" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true" minWidth="0" style="$valueStyle"/>
<Label text="Nationality" GridPane.rowIndex="4" style="$mutedStyle"/><Label fx:id="nationalityValue" GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true" minWidth="0" style="$valueStyle"/>
</GridPane></VBox>
<VBox fx:id="contactCard" minWidth="0" GridPane.fillHeight="false" GridPane.valignment="TOP" style="$cardStyle"><HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f5f6ff; -fx-background-radius: 9 9 0 0; -fx-padding: 12;"><StackPane minWidth="24" prefWidth="24"><SVGPath content="M 3 0 Q 0 0 0 4 C 0 12 10 22 18 22 Q 22 22 22 18 L 17 14 Q 15 13 13 16 C 9 14 7 11 6 8 Q 10 6 8 4 L 5 0 Z" fill="#393a7b"/></StackPane><Label text="Contact Information" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #20205e;"/><Region HBox.hgrow="ALWAYS"/><Button text="+" accessibleText="Add contact information" onAction="#addContact" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #55558d; -fx-padding: 5 10; -fx-font-size: 20px; -fx-min-width: 36; -fx-min-height: 36; -fx-cursor: hand;"></Button></HBox><VBox spacing="12" style="-fx-padding: 14 16;"><VBox spacing="5" minWidth="0"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Primary email" style="$mutedStyle"/><Region HBox.hgrow="ALWAYS"/><Button text="" accessibleText="Edit email" onAction="#editEmail" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #55558d; -fx-padding: 4 7; -fx-cursor: hand;"><graphic><SVGPath content="M 1 15 L 4 8 L 12 0 L 16 4 L 8 12 Z M 4 8 L 8 12 M 10 2 L 14 6" fill="transparent" stroke="#55558d" strokeWidth="1.3"/></graphic></Button></HBox>
