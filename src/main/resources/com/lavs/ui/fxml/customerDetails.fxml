     <String fx:id="loanStatusStyle" fx:value="-fx-background-color: #d9f3ec; -fx-background-radius: 12; -fx-text-fill: #329e8a; -fx-font-size: 11px; -fx-padding: 2 12;"/>
     <String fx:id="loanActionStyle" fx:value="-fx-background-color: transparent; -fx-text-fill: #747ba6; -fx-font-size: 19px; -fx-padding: 2 12; -fx-cursor: hand;"/>
