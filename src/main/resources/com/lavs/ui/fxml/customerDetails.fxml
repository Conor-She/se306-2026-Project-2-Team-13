    <Label text="Status" GridPane.columnIndex="4" style="$loanHeaderStyle"/>
    <Label text="Actions" GridPane.columnIndex="5" style="$loanHeaderStyle"/>
   </GridPane>
  </VBox></content>
 </ScrollPane>
 <ScrollPane fx:id="notesContent" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white; -fx-padding: 0;">
  <content><VBox fx:id="notesList" spacing="10" minWidth="0" style="-fx-padding: 0 12 12 12;">
   <fx:define>
    <String fx:id="noteCardStyle" fx:value="-fx-background-color: white; -fx-border-color: #e2e9fc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14 18;"/>
