    <String fx:id="noteMetaStyle" fx:value="-fx-font-size: 11px; -fx-text-fill: #747ba6;"/>
    <String fx:id="noteActionStyle" fx:value="-fx-background-color: transparent; -fx-text-fill: #747ba6; -fx-font-size: 28px; -fx-padding: 4 12; -fx-min-width: 44; -fx-min-height: 44; -fx-cursor: hand;"/>
   </fx:define>
