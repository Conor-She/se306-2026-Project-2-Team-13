 <Button fx:id="viewAllEmail" text="View all emails  &#x2192;" onAction="#viewEmail" visible="false" managed="false" style="-fx-background-color: transparent; -fx-text-fill: #6255cc; -fx-font-size: 11px; -fx-padding: 0; -fx-cursor: hand;"/>
 </VBox><VBox spacing="5" minWidth="0"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Primary phone" style="$mutedStyle"/><Region HBox.hgrow="ALWAYS"/><Button text="" accessibleText="Edit phone" onAction="#editPhone" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #55558d; -fx-padding: 4 7; -fx-cursor: hand;"><graphic><SVGPath content="M 1 15 L 4 8 L 12 0 L 16 4 L 8 12 Z M 4 8 L 8 12 M 10 2 L 14 6" fill="transparent" stroke="#55558d" strokeWidth="1.3"/></graphic></Button></HBox>
 <Label fx:id="phoneValue" wrapText="true" minWidth="0" style="$valueStyle"/>
 <Button fx:id="viewAllPhone" text="View all phone numbers  &#x2192;" onAction="#viewPhone" visible="false" managed="false" style="-fx-background-color: transparent; -fx-text-fill: #6255cc; -fx-font-size: 11px; -fx-padding: 0; -fx-cursor: hand;"/>
 </VBox><VBox spacing="5" minWidth="0"><HBox alignment="CENTER_LEFT" spacing="8"><Label text="Mailing address" style="$mutedStyle"/><Region HBox.hgrow="ALWAYS"/><Button text="" accessibleText="Edit address" onAction="#editAddress" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #55558d; -fx-padding: 4 7; -fx-cursor: hand;"><graphic><SVGPath content="M 1 15 L 4 8 L 12 0 L 16 4 L 8 12 Z M 4 8 L 8 12 M 10 2 L 14 6" fill="transparent" stroke="#55558d" strokeWidth="1.3"/></graphic></Button></HBox>
 <Label fx:id="addressValue" wrapText="true" minWidth="0" style="$valueStyle"/>
 <Button fx:id="viewAllAddress" text="View all addresses  &#x2192;" onAction="#viewAddress" visible="false" managed="false" style="-fx-background-color: transparent; -fx-text-fill: #6255cc; -fx-font-size: 11px; -fx-padding: 0; -fx-cursor: hand;"/>
 </VBox></VBox><VBox fx:id="additionalContacts" visible="false" managed="false"/></VBox>
<VBox fx:id="employmentCard" minWidth="0" GridPane.fillHeight="false" GridPane.valignment="TOP" style="$cardStyle"><HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f5f6ff; -fx-background-radius: 9 9 0 0; -fx-padding: 12;"><StackPane minWidth="24" prefWidth="24"><SVGPath content="M 7 0 H 15 Q 17 0 17 2 V 5 H 21 Q 23 5 23 7 V 19 Q 23 21 21 21 H 2 Q 0 21 0 19 V 7 Q 0 5 2 5 H 5 V 2 Q 5 0 7 0 Z M 7 2 V 5 H 15 V 2 Z" fill="#393a7b"/></StackPane><Label text="Employment" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #20205e;"/><Region HBox.hgrow="ALWAYS"/><Button text="+" accessibleText="Add employer" onAction="#addEmployer" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #55558d; -fx-padding: 5 10; -fx-font-size: 20px; -fx-min-width: 36; -fx-min-height: 36; -fx-cursor: hand;"></Button></HBox><VBox spacing="10" style="-fx-padding: 14 12;">
 <HBox fx:id="primaryEmployerRow" alignment="TOP_LEFT" spacing="8" style="-fx-padding: 12; -fx-border-color: #dce2ff; -fx-border-radius: 8; -fx-background-radius: 8;">
 <VBox spacing="6" minWidth="0" HBox.hgrow="ALWAYS"><Label fx:id="employerNameValue" wrapText="true" style="$titleStyle"/><Label fx:id="employmentSummaryValue" wrapText="true" minWidth="0" style="$mutedStyle"/></VBox>
<Button text="" accessibleText="Edit employment" onAction="#editEmployment" style="-fx-background-color: white; -fx-border-color: #dce2ff; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #55558d; -fx-padding: 4 7; -fx-cursor: hand;"><graphic><SVGPath content="M 1 15 L 4 8 L 12 0 L 16 4 L 8 12 Z M 4 8 L 8 12 M 10 2 L 14 6" fill="transparent" stroke="#55558d" strokeWidth="1.3"/></graphic></Button><Button accessibleText="Delete employment" onAction="#deleteEmployer" minWidth="28" minHeight="28" style="-fx-background-color: transparent; -fx-padding: 4; -fx-cursor: hand;"><graphic><SVGPath content="M 1 4 H 15 M 5 4 V 1 H 11 V 4 M 3 4 L 4 18 H 12 L 13 4 M 6 7 V 15 M 10 7 V 15" fill="transparent" stroke="#b42318" strokeWidth="1.5"/></graphic><tooltip><Tooltip text="Delete employer"/></tooltip></Button></HBox><VBox fx:id="additionalEmployers" spacing="10"/></VBox></VBox>
 </GridPane>
 </VBox></content>
 </ScrollPane>
 <ScrollPane fx:id="loansContent" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white; -fx-padding: 0;">
  <content><VBox spacing="16" minWidth="0" style="-fx-padding: 0 12 12 12;">
   <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #f2f6ff; -fx-background-radius: 9; -fx-padding: 12 14;">
