<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="868" prefHeight="490" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #F5F5FA; -fx-font-family: 'Arial';">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #393A7B;">
            <padding><Insets top="16" right="24" bottom="16" left="24" /></padding>
            <Label text="Dashboard" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <ImageView fitWidth="150" preserveRatio="true" accessibleText="Countrywide Bank">
                <image><Image url="@images/logo.jpg" /></image>
            </ImageView>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="12">
            <Label text="Welcome to your dashboard" style="-fx-font-size: 26px; -fx-text-fill: #393A7B;" />
            <Label text="You have successfully signed in." style="-fx-font-size: 16px;" />
        </VBox>
    </center>
</BorderPane>
